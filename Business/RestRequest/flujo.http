POST {{host}}/cotizacion/{{cotizacionId}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Enviada"
}

### 41. Aprobar cotización y crear proyecto
# Esperado: 200
# Crea un proyecto nuevo. Reaprobar la misma cotización devuelve ese mismo proyecto.
# @name aprobacion
POST {{host}}/cotizacion/{{cotizacionId}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Aprobada"
}

### 42. Listar proyectos
# Esperado: 200
GET {{host}}/proyecto
Authorization: Bearer {{token}}

### 43. Consultar proyecto recién aprobado
# Esperado: 200
