# Pruebas positivas de la API Business (extensión REST Client de VS Code).
# Requisitos: Docker iniciado y semillas locales cargadas (Data/tests/seed.php).
# Ejecutar cada "Send Request" UNA VEZ, de arriba hacia abajo, sin saltar pasos.
# Para repetir el recorrido, empezar desde 01: se crean datos ficticios nuevos.
# Los IDs, usuarios y UUID se toman de las respuestas; no copiar IDs de otra ejecución.
# No repetir estados ni pagos ya confirmados: sus reglas siguen aplicándose.
# Las respuestas de solicitudes con @name deben conservarse en esta sesión del editor.
# El paso de refresco invalida el token anterior: por eso está al final.
#
# Cobertura: todas las operaciones publicadas, con GET, POST, los seis PUT y DELETE.
# No hay DELETE de proyectos/visitas ni PUT de visitas/solicitudes: se conserva historial.
# DELETE de pago ANULA el registro. Las demás eliminaciones usan datos sin relaciones.
# El escenario comercial queda guardado como demostración (total recibido: CRC 150000).
# Archivo para multipart: ./archivos/foto-prueba.png (imagen ficticia incluida).
# Sintaxis de variables y archivos: https://github.com/Huachao/vscode-restclient
#
@host = http://localhost:9091/api
@token = {{login.response.body.$.token}}
@clienteId = {{cliente.response.body.$.data.id}}
@servicioId = {{servicio.response.body.$.data.id}}
@cotizacionId = {{cotizacion.response.body.$.data.id}}
@proyectoId = {{aprobacion.response.body.$.data.proyecto.id}}
@tokenTecnico = {{loginTecnico.response.body.$.token}}
@visitaId = {{visita.response.body.$.data.id}}

### 01. Comprobar API y base de datos
# Esperado: 200
GET {{host}}/health

### 02. Consultar documentación Swagger
# Esperado: 200
GET {{host}}/docs

### 03. Consultar contrato OpenAPI
# Esperado: 200
GET {{host}}/openapi.json

### 04. Consultar catálogo público
# Esperado: 200
GET {{host}}/public/servicio

### 05. Iniciar sesión del administrador local
# Esperado: 200
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "adminforestal",
  "password": "Forestal2026!"
}

### 06. Consultar sesión actual
# Esperado: 200
GET {{host}}/auth/me
Authorization: Bearer {{token}}

### 07. Crear usuario temporal para CRUD
# Esperado: 201
# @name usuarioTemporal
POST {{host}}/usuario
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "tmp{{$randomInt 100000000 999999999}}",
  "password": "Forestal2026!",
  "nombre_completo": "Usuario temporal de prueba",
  "email": "{{$guid}}@example.test",
  "rol_id": 3
}

### 08. Listar usuarios
# Esperado: 200
GET {{host}}/usuario
Authorization: Bearer {{token}}

### 09. Consultar usuario temporal
# Esperado: 200
GET {{host}}/usuario/{{usuarioTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 10. Filtrar usuarios con paginación
# Esperado: 200
GET {{host}}/usuario/filter/0/20
Authorization: Bearer {{token}}

### 11. Actualizar usuario temporal con PUT
# Esperado: 200
PUT {{host}}/usuario/{{usuarioTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre_completo": "Usuario temporal actualizado"
}

### 12. Eliminar usuario sin relaciones
# Esperado: 200
DELETE {{host}}/usuario/{{usuarioTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 13. Crear cliente temporal para CRUD
# Esperado: 201
# @name clienteTemporal
POST {{host}}/cliente
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cedula": "TMP-{{$timestamp}}-{{$randomInt 1000 9999}}",
  "nombre_completo": "Cliente temporal",
  "email": "{{$guid}}@example.test"
}

### 14. Listar clientes
# Esperado: 200
GET {{host}}/cliente
Authorization: Bearer {{token}}

### 15. Consultar cliente temporal
# Esperado: 200
GET {{host}}/cliente/{{clienteTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 16. Filtrar clientes con paginación
# Esperado: 200
GET {{host}}/cliente/filter/0/20
Authorization: Bearer {{token}}

### 17. Actualizar cliente temporal con PUT
# Esperado: 200
PUT {{host}}/cliente/{{clienteTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "telefono": "2222-0000",
  "direccion": "Dirección ficticia actualizada"
}

### 18. Eliminar cliente sin cotizaciones
# Esperado: 200
DELETE {{host}}/cliente/{{clienteTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 19. Crear servicio temporal para CRUD
# Esperado: 201
# @name servicioTemporal
POST {{host}}/servicio
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Temporal {{$guid}}",
  "descripcion": "Servicio ficticio que será eliminado",
  "activo": true
}

### 20. Listar servicios administrativos
# Esperado: 200
GET {{host}}/servicio
Authorization: Bearer {{token}}

### 21. Consultar servicio temporal
# Esperado: 200
GET {{host}}/servicio/{{servicioTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 22. Filtrar servicios con paginación
# Esperado: 200
GET {{host}}/servicio/filter/0/20
Authorization: Bearer {{token}}

### 23. Actualizar servicio temporal con PUT
# Esperado: 200
PUT {{host}}/servicio/{{servicioTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}
