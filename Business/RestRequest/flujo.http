### 45. Actualizar nombre del proyecto con PUT
# Esperado: 200
PUT {{host}}/proyecto/{{proyectoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Inventario forestal de finca demostrativa"
}

### 46. Asignar técnico antes de iniciar trabajo y facturar
# Esperado: 200
POST {{host}}/proyecto/{{proyectoId}}/tecnico
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "tecnico_id": {{usuarioTecnico.response.body.$.data.id}}
}

### 47. Crear pago temporal pendiente
# Esperado: 201
# @name pagoTemporal
POST {{host}}/pago
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "proyecto_id": {{proyectoId}},
  "tipo": "Anticipo",
  "monto": "1000.00",
  "moneda": "CRC",
  "estado": "Pendiente",
  "fecha_pago": "2026-11-22T10:00:00-06:00",
  "referencia": "TEMPORAL-ANULAR"
}

### 48. Consultar pago temporal
# Esperado: 200
GET {{host}}/pago/{{pagoTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 49. Actualizar pago pendiente con PUT
# Esperado: 200
PUT {{host}}/pago/{{pagoTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "monto": "2000.00",
  "referencia": "TEMPORAL-CORREGIDO"
}

### 50. Anular pago temporal con DELETE
# Esperado: 200
# Devuelve estado Anulado; se conserva la trazabilidad y no suma a ingresos.
DELETE {{host}}/pago/{{pagoTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 51. Crear anticipo comercial pendiente
# Esperado: 201
# @name anticipo
POST {{host}}/pago
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "proyecto_id": {{proyectoId}},
  "tipo": "Anticipo",
  "monto": "50000.00",
  "moneda": "CRC",
  "estado": "Pendiente",
  "fecha_pago": "2026-11-22T10:00:00-06:00",
  "referencia": "DEMO-ANTICIPO"
}

### 52. Confirmar anticipo con PUT
# Esperado: 200
# Tras recibirlo ya no se edita. No repetir el POST anterior para confirmar.
PUT {{host}}/pago/{{anticipo.response.body.$.data.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Recibido"
}

### 53. Iniciar trabajo de campo
# Esperado: 200
POST {{host}}/proyecto/{{proyectoId}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "En campo",
  "motivo": "Inicio del inventario"
}

### 54. Iniciar sesión independiente del técnico creado
# Esperado: 200
# @name loginTecnico
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "{{usuarioTecnico.response.body.$.data.username}}",
  "password": "Forestal2026!"
}

### 55. Registrar visita nueva con ubicación
# Esperado: 201
# El UUID se genera aquí; el reintento siguiente usa el que respondió el servidor.
# @name visita
POST {{host}}/visita
Authorization: Bearer {{tokenTecnico}}
Content-Type: application/json

{
  "uuid": "{{$guid}}",
  "proyecto_id": {{proyectoId}},
  "fecha_captura": "2026-11-22T10:30:00-06:00",
  "observaciones": "Observación ficticia del inventario forestal",
  "latitud": 9.9,
  "longitud": -84.1
}

### 56. Reintentar sincronización de la MISMA visita sin duplicar
# Esperado: 200
# @name reintentoVisita
POST {{host}}/visita
Authorization: Bearer {{tokenTecnico}}
Content-Type: application/json

{
  "uuid": "{{visita.response.body.$.data.uuid}}",
  "proyecto_id": {{proyectoId}},
  "fecha_captura": "{{visita.response.body.$.data.fecha_captura}}",
  "observaciones": "{{visita.response.body.$.data.observaciones}}",
  "latitud": "{{visita.response.body.$.data.latitud}}",
  "longitud": "{{visita.response.body.$.data.longitud}}"
}

### 57. Listar visitas del técnico
# Esperado: 200
GET {{host}}/visita
Authorization: Bearer {{tokenTecnico}}

### 58. Consultar visita por ID
# Esperado: 200
GET {{host}}/visita/{{visitaId}}
Authorization: Bearer {{tokenTecnico}}

### 59. Filtrar visitas con paginación
# Esperado: 200
GET {{host}}/visita/filter/0/20?proyecto_id={{proyectoId}}
Authorization: Bearer {{tokenTecnico}}

### 60. Consultar visita por UUID
# Esperado: 200
GET {{host}}/visita/uuid/{{visita.response.body.$.data.uuid}}
Authorization: Bearer {{tokenTecnico}}

### 61. Adjuntar foto ficticia con el técnico autor
# Esperado: 201
# @name foto
POST {{host}}/visita/{{visitaId}}/evidencia
Authorization: Bearer {{tokenTecnico}}
Content-Type: multipart/form-data; boundary=ambientalBoundary

--ambientalBoundary
Content-Disposition: form-data; name="uuid"

{{$guid}}
--ambientalBoundary
Content-Disposition: form-data; name="archivo"; filename="foto-prueba.png"
Content-Type: image/png

< ./archivos/foto-prueba.png
--ambientalBoundary--


### 62. Reintentar la MISMA foto sin duplicar
# Esperado: 200
# @name reintentoFoto
POST {{host}}/visita/{{visitaId}}/evidencia
Authorization: Bearer {{tokenTecnico}}
Content-Type: multipart/form-data; boundary=ambientalBoundary

--ambientalBoundary
Content-Disposition: form-data; name="uuid"

{{foto.response.body.$.data.evidencias[0].uuid}}
--ambientalBoundary
Content-Disposition: form-data; name="archivo"; filename="foto-prueba.png"
Content-Type: image/png

< ./archivos/foto-prueba.png
--ambientalBoundary--


### 63. Descargar fotografía protegida
# Esperado: 200
# @name descargaFoto
GET {{host}}/evidencia/{{foto.response.body.$.data.evidencias[0].id}}
Authorization: Bearer {{token}}

### 64. Entregar informe después del trabajo de campo
# Esperado: 200
POST {{host}}/proyecto/{{proyectoId}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Informe entregado",
  "informe_referencia": "INF-DEMO-001"
}

### 65. Facturar después de entregar informe
# Esperado: 200
POST {{host}}/proyecto/{{proyectoId}}/estado
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Facturada",
  "factura_referencia": "FAC-DEMO-001"
}

### 66. Crear pago final pendiente
# Esperado: 201
# @name pagoFinal
POST {{host}}/pago
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "proyecto_id": {{proyectoId}},
  "tipo": "Final",
  "monto": "100000.00",
  "moneda": "CRC",
  "estado": "Pendiente",
  "fecha_pago": "2026-11-22T15:00:00-06:00",
  "referencia": "DEMO-FINAL"
}

### 67. Confirmar pago final con PUT
# Esperado: 200
# Anticipo 50000 + final 100000 = cotización de 150000 CRC.
PUT {{host}}/pago/{{pagoFinal.response.body.$.data.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "estado": "Recibido"
}

### 68. Listar pagos
# Esperado: 200
GET {{host}}/pago
Authorization: Bearer {{token}}

### 69. Filtrar pagos con paginación
# Esperado: 200
GET {{host}}/pago/filter/0/20?proyecto_id={{proyectoId}}
Authorization: Bearer {{token}}

### 70. Consultar proyecto facturado e historial
# Esperado: 200
GET {{host}}/proyecto/{{proyectoId}}
Authorization: Bearer {{token}}

### 71. Consultar ingresos del proyecto
# Esperado: 200
# @name ingresos
GET {{host}}/reporte/ingresos?proyecto_id={{proyectoId}}
Authorization: Bearer {{token}}

### 72. Consultar proyectos por estado
# Esperado: 200
GET {{host}}/reporte/proyectos-estado?proyecto_id={{proyectoId}}
Authorization: Bearer {{token}}

### 73. Consultar visitas por proyecto y período
# Esperado: 200
GET {{host}}/reporte/visitas?proyecto_id={{proyectoId}}&desde=2026-11-22T00:00:00Z&hasta=2026-11-23T00:00:00Z
Authorization: Bearer {{token}}

### 74. Consultar puntos del mapa
# Esperado: 200
GET {{host}}/reporte/mapa?proyecto_id={{proyectoId}}
Authorization: Bearer {{token}}

### 75. Iniciar sesión del cliente vinculado
# Esperado: 200
# @name loginCliente
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "{{usuarioCliente.response.body.$.data.username}}",
  "password": "Forestal2026!"
}

### 76. Consultar proyecto propio como cliente
# Esperado: 200
GET {{host}}/proyecto/{{proyectoId}}
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 77. Cerrar sesión del cliente
# Esperado: 200
DELETE {{host}}/auth/logout/{{loginCliente.response.body.$.user.id}}
Authorization: Bearer {{loginCliente.response.body.$.token}}

### 78. Cerrar sesión del técnico
# Esperado: 200
DELETE {{host}}/auth/logout/{{loginTecnico.response.body.$.user.id}}
Authorization: Bearer {{tokenTecnico}}

### 79. Renovar sesión del administrador al final
# Esperado: 200
# @name renovarSesion
POST {{host}}/auth/refresh
Content-Type: application/json

{
  "tkRef": "{{login.response.body.$.tkRef}}"
}

### 80. Consultar sesión con el token renovado
# Esperado: 200
GET {{host}}/auth/me
Authorization: Bearer {{renovarSesion.response.body.$.token}}

### 81. Cerrar sesión del administrador con el token renovado
# Esperado: 200
DELETE {{host}}/auth/logout/{{renovarSesion.response.body.$.user.id}}
Authorization: Bearer {{renovarSesion.response.body.$.token}}
