# Esperado: 200
DELETE {{host}}/cotizacion/{{cotizacionTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}

### 36. Crear cotización comercial nueva
# Esperado: 201
# @name cotizacion
POST {{host}}/cotizacion
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cliente_id": {{clienteId}},
  "servicio_id": {{servicioId}},
  "descripcion": "Inventario forestal de finca demostrativa",
  "monto": "150000.00",
  "moneda": "CRC",
  "solicitud_id": {{solicitud.response.body.$.data.id}}
}

### 37. Listar cotizaciones
# Esperado: 200
GET {{host}}/cotizacion
Authorization: Bearer {{token}}

### 38. Consultar cotización comercial
