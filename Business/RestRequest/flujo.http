# @name solicitud
POST {{host}}/public/solicitud
Content-Type: application/json

{
  "servicio_id": {{servicioId}},
  "nombre_completo": "Solicitante de prueba",
  "email": "solicitud@example.test",
  "telefono": "2222-0000",
  "descripcion": "Solicito cotizar un inventario de la finca demostrativa"
}

### 30. Listar solicitudes recibidas
# Esperado: 200
GET {{host}}/solicitud
Authorization: Bearer {{token}}

### 31. Consultar solicitud creada
# Esperado: 200
GET {{host}}/solicitud/{{solicitud.response.body.$.data.id}}
Authorization: Bearer {{token}}

