POST {{host}}/cotizacion
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "cliente_id": {{clienteId}},
  "servicio_id": {{servicioId}},
  "descripcion": "Borrador ficticio para eliminación",
  "monto": "1000.00",
  "moneda": "CRC"
}

### 34. Actualizar cotización temporal con PUT
# Esperado: 200
PUT {{host}}/cotizacion/{{cotizacionTemporal.response.body.$.data.id}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "descripcion": "Borrador corregido",
  "monto": "2000.00"
}

